    <PackageReference Include="Bansi.Application.UtilGlobSeg.Security.Management" Version="6.0.0" />
    <PackageReference Include="Bansi.Configuration.Install" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="6.0.36" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bansi.CredPC.AdministracionCartera.Service.Datos\Bansi.CredPC.AdministracionCartera.Service.Datos.csproj" />
    <ProjectReference Include="..\Bansi.CredPC.AdministracionCartera.Service.Modelo\Bansi.CredPC.AdministracionCartera.Service.Modelo.csproj" />
    <ProjectReference Include="..\Bansi.CredPC.AdministracionCartera.Service.Negocio\Bansi.CredPC.AdministracionCartera.Service.Negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Bansi.CredPC.Bitacora">
      <HintPath>..\..\..\..\..\Windows\Microsoft.NET\assembly\GAC_MSIL\Bansi.CredPC.Bitacora\v4.0_1.0.0.0__283cf484dcb95329\Bansi.CredPC.Bitacora.dll</HintPath>
    </Reference>
    <Reference Include="Bansi.UtilGlob.Seguridad">
      <HintPath>..\..\..\..\..\Program Files (x86)\Common Files\Bansi\Assembly\Bansi.UtilGlob.Seguridad.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="ClearReferences.cmd &quot;$(TargetDir)&quot; &quot;$(TargetName)&quot;" />
  </Target>

</Project>
