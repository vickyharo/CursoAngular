<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <SignAssembly>True</SignAssembly>
	<AssemblyOriginatorKeyFile>..\..\..\StrongName\bansi.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bansi.Application.Security.FactoryProviders" Version="6.0.0" />
    <PackageReference Include="Bansi.Application.UtilGlobSeg.Security" Version="6.5.0" />
    <PackageReference Include="Bansi.Application.UtilGlobSeg.Security.Information" Version="6.5.0" />
    <PackageReference Include="Bansi.Application.UtilGlobSeg.Security.Management" Version="6.0.0" />
    <PackageReference Include="Bansi.Configuration.Install" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="6.0.36" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bansi.CredPC.ModificaCredito.Service.Datos\Bansi.CredPC.ModificaCredito.Service.Datos.csproj" />
    <ProjectReference Include="..\Bansi.CredPC.ModificaCredito.Service.Modelo\Bansi.CredPC.ModificaCredito.Service.Modelo.csproj" />
    <ProjectReference Include="..\Bansi.CredPC.ModificaCredito.Service.Negocio\Bansi.CredPC.ModificaCredito.Service.Negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Bansi.CredPC.Bitacora">
      <HintPath>..\..\..\..\..\Personal\DLLS's y registros\Bansi.CredPC.Bitacora.dll</HintPath>
    </Reference>
    <Reference Include="Bansi.UtilGlob.Seguridad">
      <HintPath>..\..\..\..\..\Program Files (x86)\Common Files\Bansi\Assembly\Bansi.UtilGlob.Seguridad.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="ClearReferences.cmd &quot;$(TargetDir)&quot; &quot;$(TargetName)&quot;" />
  </Target>

</Project>
